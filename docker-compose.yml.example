services:
  tdl-bot:
    image: ghcr.io/1368129224/tgbot-for-tdl:main
    # To build locally instead, comment out the image line above and uncomment:
    # build:
    #   context: .
    #   dockerfile: Dockerfile
    container_name: tdl-bot
    restart: unless-stopped
    # Use host network so 127.0.0.1 proxy in config reaches the host
    network_mode: host
    volumes:
      - ./tdl_bot_config.toml:/app/tdl_bot_config.toml:ro
      - ./downloads:/downloads
      # Persist tdl session (login state) across container restarts
      - ~/.tdl:/root/.tdl
    environment:
      - TZ=Asia/Shanghai
